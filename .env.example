# Copie ce fichier en .env  (cp .env.example .env)
# .env est ignore par git : tes secrets locaux ne sont jamais commits.

# Chemin vers la base SQLite de developpement.
# "file:" = fichier local ; le chemin est relatif au dossier prisma/ ou a la racine
# selon l'outil qui le lit. On reste simple : un fichier dev.db a la racine.
DATABASE_URL="file:./dev.db"
